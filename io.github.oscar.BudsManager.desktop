[Desktop Entry]
Type=Application
Name=Buds Manager
GenericName=Control de auriculares
Comment=Controla tus REDMI Buds: cancelación de ruido, ecualizador, gestos y batería
Exec=/home/oscar/.local/bin/buds-manager
Icon=audio-headphones
Terminal=false
Categories=AudioVideo;Audio;Settings;HardwareSettings;
Keywords=buds;auriculares;audífonos;redmi;xiaomi;anc;bluetooth;
StartupNotify=true
StartupWMClass=io.github.oscar.BudsManager
